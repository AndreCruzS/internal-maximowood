# Maximo Sales Calculator — environment template
# Copy to .env.local for development; set the same vars in Vercel for production.

# ── Auth (Supabase Auth — email + password) ────────────────────────────────────
# The production Supabase project. Users are managed in Supabase Dashboard →
# Authentication → Users (start with the single shared team account; add
# individual accounts later — no code change needed).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key

# ── Live Maximo inventory view (André's Supabase — external, read-only) ────────
SUPABASE_INVENTORY_URL=https://YOUR_INVENTORY_PROJECT.supabase.co
SUPABASE_INVENTORY_ANON_KEY=replace-with-inventory-anon-key
SUPABASE_INVENTORY_JWT=replace-with-inventory-server-bearer-token

# ── App's own Supabase tables (inventory, inventorySyncLog) ────────────────────
# Same project as auth is fine. Apply supabase/migrations/*.sql first.
# Used only by the nightly inventory sync (parity with the Manus cron).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# ── Vercel Cron guard (see vercel.json → /api/cron/inventory-sync) ─────────────
# Vercel sends this automatically as `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=replace-with-a-long-random-secret
