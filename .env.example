# Maximo Sales Calculator — environment template
# Copy to .env.local for development; set the same vars in Vercel for production.

# ── Auth (Supabase Auth — email + password) ────────────────────────────────────
# The production Supabase project. Individual logins can be created from the
# in-app admin panel (/admin) — see CALCULATOR_ADMIN_EMAILS below — or still
# by hand in Supabase Dashboard → Authentication → Users.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key

# ── Admin panel (/admin — create & manage team logins) ────────────────────────
# Comma-separated allowlist of emails that may open /admin and create logins.
# A user whose Supabase app_metadata.role is "admin" also qualifies.
# Requires SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY below to be set.
CALCULATOR_ADMIN_EMAILS=you@lumberplus.com

# ── Live Maximo inventory view (André's Supabase — external, read-only) ────────
SUPABASE_INVENTORY_URL=https://YOUR_INVENTORY_PROJECT.supabase.co
SUPABASE_INVENTORY_ANON_KEY=replace-with-inventory-anon-key
SUPABASE_INVENTORY_JWT=replace-with-inventory-server-bearer-token

# ── App's own Supabase project (service role) ─────────────────────────────────
# Same project as auth. Apply supabase/migrations/*.sql first.
# Used by the nightly inventory sync AND by the /admin panel to create,
# list, reset and delete auth users (supabase.auth.admin.*). Keep secret —
# server-only, never exposed to the browser.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# ── Vercel Cron guard (see vercel.json → /api/cron/inventory-sync) ─────────────
# Vercel sends this automatically as `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=replace-with-a-long-random-secret
