# Maximo Sales Calculator — environment template
# Copy to .env.local for development; set the same vars in Vercel for production.

# ── Auth (Supabase Auth — email + password) ────────────────────────────────────
# The production Supabase project. Individual logins can be created from the
# in-app admin panel (/admin) — see CALCULATOR_ADMIN_EMAILS below — or still
# by hand in Supabase Dashboard → Authentication → Users.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key

# ── Admin panel (/admin — create & manage team logins) ────────────────────────
# Comma-separated allowlist of emails that may open /admin and create logins.
# A user whose Supabase app_metadata.role is "admin" also qualifies.
# Requires SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY below to be set.
CALCULATOR_ADMIN_EMAILS=you@lumberplus.com

# ── Live Maximo inventory view (André's Supabase — external, read-only) ────────
SUPABASE_INVENTORY_URL=https://YOUR_INVENTORY_PROJECT.supabase.co
SUPABASE_INVENTORY_ANON_KEY=replace-with-inventory-anon-key
SUPABASE_INVENTORY_JWT=replace-with-inventory-server-bearer-token

# ── App's own Supabase project (service role) ─────────────────────────────────
# Same project as auth. Apply supabase/migrations/*.sql first.
# Used by the nightly inventory sync AND by the /admin panel to create,
# list, reset and delete auth users (supabase.auth.admin.*). Keep secret —
# server-only, never exposed to the browser.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# ── Vercel Cron guard (see vercel.json → /api/cron/inventory-sync) ─────────────
# Vercel sends this automatically as `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=replace-with-a-long-random-secret

# ── Ramp (Expenses) ─────────────────────────────────────────────────────────
# Developer API app created by a Ramp admin (Settings → Developer → Create app),
# client-credentials grant, scopes: users:read users:write transactions:read
# receipts:write memos:write cards:read funds:read reimbursements:read
# reimbursements:write spend_programs:read unified_requests:write
# Until these are set, /expenses runs on sample data for Finance and admins only.
RAMP_CLIENT_ID=
RAMP_CLIENT_SECRET=
# Sandbox while testing: https://demo-api.ramp.com (default: https://api.ramp.com)
RAMP_API_URL=
# Spend program people request funds against (Ramp → Spend programs).
RAMP_FUND_PROGRAM_ID=
# Secret Ramp returns when the webhook to /api/ramp/webhook is created.
RAMP_WEBHOOK_SECRET=
# Shows "Expenses" in everyone's menu (set to 1 once Ramp is connected).
NEXT_PUBLIC_RAMP_ENABLED=

# ── Rippling (US HR: people, new hires, leavers, time off) ──────────────────
# API token created by a Rippling admin who can see every US employee
# (Tools → Developer → API Tokens), read-only scopes: workers.read users.read
# departments.read teams.read work-locations.read companies.read leave_requests.read
# (names unverified — see src/server/rippling/fields.ts). Unused for 30 days, it expires;
# the nightly /api/cron/rippling-sync keeps it alive. Until it's set, /hr/rippling
# previews sample data only. HR switches the sync on in /hr/rippling.
RIPPLING_API_TOKEN=
# Defaults to https://rest.ripplingapis.com
RIPPLING_API_URL=

# ── Email (Google Workspace SMTP, from no-reply@gmxgroup.com) ───────────────
# Without SMTP_USER / SMTP_PASS emails are logged as "skipped" in email_log.
SMTP_USER=
SMTP_PASS=
# Quote emails go FROM the rep's own address: the SMTP account must be allowed to send as
# every rep (Workspace SMTP relay, or a "Send mail as" alias per rep).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# IT gets new-hire and offboarding emails.
IT_NOTIFY_EMAIL=
# The Centralized Travel Buyer / Procurement inbox: new travel requests ("URGENT" when < 15 days or urgency 4–5).
TRAVEL_PROCUREMENT_EMAIL=
# Recruiting inbox: new candidate referrals.
RECRUITING_EMAIL=

# ── HubSpot (quote dialog: "Send to customer" / "Save to HubSpot only") ─────
# Private app token (HubSpot → Settings → Integrations → Private apps). Without it the
# quote dialog runs on sample data. Scopes to grant:
#   crm.objects.contacts.read crm.objects.contacts.write
#   crm.objects.companies.read crm.objects.companies.write
#   crm.objects.deals.read crm.objects.deals.write
#   crm.objects.owners.read files.read files.write sales-email-read
# Missing companies / owners scopes don't break sending: companies are skipped and
# owners come from Admin → HubSpot, with a warning in the quote's history.
HUBSPOT_ACCESS_TOKEN=
# Optional: the HubSpot account id for "Open in HubSpot" links (read from the API otherwise).
HUBSPOT_PORTAL_ID=

