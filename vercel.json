{
  "framework": "nextjs",
  "installCommand": "pnpm install",
  "buildCommand": "next build",
  "crons": [
    {
      "path": "/api/cron/ramp-sync",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/rippling-sync",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/sanctions-refresh",
      "schedule": "30 9 * * *"
    },
    {
      "path": "/api/cron/vendor-reviews",
      "schedule": "0 12 * * *"
    }
  ]
}
